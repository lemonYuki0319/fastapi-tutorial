# 环境变量示例文件
# 复制此文件为 .env 并修改配置

# 应用配置
APP_NAME=FastAPI CRUD Tutorial
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# 服务配置
HOST=127.0.0.1
PORT=8000

# 数据库配置
DATABASE_URL=sqlite:///./test_api.db

# JWT 配置
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# CORS 配置
CORS_ORIGINS=["*"]
